<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <AssemblyName>Shadow</AssemblyName>
    <RootNamespace>Shadow</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 图标由 tools/make-icon.py 生成（多尺寸 .ico，16px 下仍可辨认）。 -->
    <ApplicationIcon>Resources\shadow.ico</ApplicationIcon>

    <Platforms>AnyCPU;x64</Platforms>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>1.0.0</Version>
    <Product>Shadow</Product>
    <Description>轻量级 Windows 11 窗口置顶与层级管理工具</Description>
    <NeutralLanguage>zh-CN</NeutralLanguage>

    <!-- M1：不做裁剪与单文件打包，先保证可编译、可调试；打包在 M6 处理 -->
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
